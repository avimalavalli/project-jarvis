{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-jarvis.local/contracts/audit-event.schema.json",
  "title": "JARVIS Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at", "event_type", "actor", "outcome", "redaction_applied"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["allowed", "denied", "failed", "observed"]},
    "reason_code": {"type": "string"},
    "correlation_id": {"type": "string"},
    "redaction_applied": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}


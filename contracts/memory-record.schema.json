{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-jarvis.local/contracts/memory-record.schema.json",
  "title": "JARVIS Canonical Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_type", "subject_id", "provenance", "confidence", "sensitivity", "status", "created_at", "updated_at"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sensitivity": {"enum": ["public", "internal", "personal", "sensitive", "restricted"]},
    "status": {"enum": ["active", "disputed", "superseded", "deleted"]},
    "retention_policy": {"type": "string"},
    "contradicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}


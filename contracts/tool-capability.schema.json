{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-jarvis.local/contracts/tool-capability.schema.json",
  "title": "JARVIS Tool Capability Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "subject", "tool", "operations", "issued_at", "expires_at", "revocable"],
  "properties": {
    "grant_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "resource_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocable": {"const": true},
    "confirmation_id": {"type": "string"}
  }
}

